# ---- dependencies
node_modules/

# ---- generated build output
# Everything here is reproducible from source with `./build.sh`. The single-file
# HTML in particular is ~1.9 MB and rewritten on every build, which is not
# something to keep 400 revisions of in git history.
ui/engine.js
ui/thailand-2030.html
engine/src/gen/

# ---- generated analysis output
# Program output, not source. Every one of these is regenerated by a script in
# scripts/ and none of them is edited by hand, so a diff on them is noise.
AGENDA.txt
BACKTEST.txt
ESTIMATION_OUTPUT.txt
ESTIMATION_PHILLIPS.txt
ESTIMATION_TRADE.txt
PLAYTHROUGH.txt
PROLOGUE.txt
SCENARIOS.txt
SIMULATION.txt
TURNLOOP.txt

# ---- third-party media
# The 2023 Bhumjaithai campaign song — both the source file dropped in the
# project root and the copy the build inlines from ui/assets/. It is somebody
# else's recording and not ours to redistribute, so it stays out of the
# repository entirely; the build detects its absence and omits the music player.
#
# Matched globally rather than by path, deliberately. A pattern anchored to
# ui/assets/ silently misses the original sitting next to it, which is exactly
# the kind of near-miss that puts a copyrighted file in a public repo.
*.mp3
*.mp4
*.m4a
*.wav
*.mov
*.webm
*.ogg

# ---- personal play records
# Terms worth keeping, but they are a scrapbook rather than part of the project,
# and every one of them is a spoiler for a run somebody else has not played yet.
saved_runs/

# ---- local
.DS_Store
*.log
.venv/
__pycache__/
*.pyc
_stale/
_to_delete/
.tsbuildinfo
*.tsbuildinfo
